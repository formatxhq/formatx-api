# Copy to .env for local development. Every variable is optional locally;
# src/config/env.ts lists them all, with defaults, and what production requires.

PORT=8080
PUBLIC_API_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:4200

# Unset DATABASE_URL = embedded PGlite. PGLITE_DIR keeps it between restarts.
# DATABASE_URL=postgres://user:pass@host:5432/formatx
PGLITE_DIR=.data/pglite

# local = a folder on disk; memory = gone on restart; s3 = Cloudflare R2 (production).
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=.data/files
# S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# S3_BUCKET=formatx-files
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

ANON_FILE_TTL_SECONDS=3600
MAX_UPLOAD_BYTES=50000000

# Run cleanup in-process every minute while developing.
CLEANUP_INTERVAL_SECONDS=60
# INTERNAL_SECRET=at-least-32-characters-long-random-string
